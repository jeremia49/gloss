# Public hostname: create a DNS A/AAAA record pointing at this server first.
GLOSS_DOMAIN=gloss.example.com

# Required. Generate with: openssl rand -hex 24
GLOSS_PASSWORD=replace-with-a-long-random-password
GLOSS_USERNAME=gloss
GLOSS_SESSION_DAYS=30

# Optional. Signs session cookies; changing it signs everyone out.
# Leave unset to generate one in the persistent data volume.
# GLOSS_SECRET_KEY=